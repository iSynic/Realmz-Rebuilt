[node name="LayoutRow" type="BoxContainer" parent="SettingsScroll/SettingsPanel/Content/LayoutGroup/Content" groups=["system_setting_rows"]]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Caption" type="Label" parent="SettingsScroll/SettingsPanel/Content/LayoutGroup/Content/LayoutRow"]
custom_minimum_size = Vector2(210, 0)
layout_mode = 2
text = "HUD layout"
tooltip_text = "Fixed keeps the familiar layout. Modular places the same four panels over the map."

[node name="LayoutChoice" type="OptionButton" parent="SettingsScroll/SettingsPanel/Content/LayoutGroup/Content/LayoutRow"]
custom_minimum_size = Vector2(180, 0)
layout_mode = 2
size_flags_horizontal = 3
fit_to_longest_item = false
tooltip_text = "Fixed is the default. Modular retains its panel settings while Fixed is selected."
item_count = 2
popup/item_0/text = "Fixed"
popup/item_1/text = "Modular"

[node name="CombatLayoutRow" type="BoxContainer" parent="SettingsScroll/SettingsPanel/Content/LayoutGroup/Content" groups=["system_setting_rows"]]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Caption" type="Label" parent="SettingsScroll/SettingsPanel/Content/LayoutGroup/Content/CombatLayoutRow"]
custom_minimum_size = Vector2(210, 0)
layout_mode = 2
text = "Combat HUD layout"
tooltip_text = "Combat keeps its own choice and its own arrangement, separate from the overworld."

[node name="CombatLayoutChoice" type="OptionButton" parent="SettingsScroll/SettingsPanel/Content/LayoutGroup/Content/CombatLayoutRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 0)
layout_mode = 2
size_flags_horizontal = 3
fit_to_longest_item = false
tooltip_text = "Fixed is the default. The modular combat layout is still being built; this choice is remembered for it."
item_count = 2
popup/item_0/text = "Fixed"
popup/item_1/text = "Modular"

[node name="CombatScaleRow" type="BoxContainer" parent="SettingsScroll/SettingsPanel/Content/LayoutGroup/Content" groups=["system_setting_rows"]]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Caption" type="Label" parent="SettingsScroll/SettingsPanel/Content/LayoutGroup/Content/CombatScaleRow"]
custom_minimum_size = Vector2(210, 0)
layout_mode = 2
text = "Combat panel size"
tooltip_text = "Sets the combatant card, turn order and command groups to one size; they start at 125% and 150%. Right-click a panel in battle to size it on its own."

[node name="CombatScaleSlider" type="HSlider" parent="SettingsScroll/SettingsPanel/Content/LayoutGroup/Content/CombatScaleRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(140, 0)
layout_mode = 2
size_flags_horizontal = 3
min_value = 75.0
max_value = 200.0
step = 25.0
value = 150.0
tick_count = 6
ticks_on_borders = true
tooltip_text = "Set the combat panels' size from 75 to 200 percent."

[node name="CombatScaleValue" type="Label" parent="SettingsScroll/SettingsPanel/Content/LayoutGroup/Content/CombatScaleRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(48, 0)
layout_mode = 2
text = "150%"
horizontal_alignment = 2

