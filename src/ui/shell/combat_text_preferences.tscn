[node name="PreviewColumn" type="VBoxContainer" parent="Columns"]
custom_minimum_size = Vector2(0, 0)
layout_mode = 2
size_flags_horizontal = 0
theme_override_constants/separation = 10

[node name="PreviewHeading" type="Label" parent="Columns/PreviewColumn"]
layout_mode = 2
text = "Live preview"
