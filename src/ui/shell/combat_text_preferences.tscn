layout_mode = 2
text = "Scrolling text speed"

[node name="CombatTextSpeedValue" type="Label" parent="Columns/ControlsColumn/CombatTextSpeedGroup/CombatTextSpeedRow"]
layout_mode = 2
size_flags_horizontal = 3
horizontal_alignment = 2
text = "100%"

[node name="CombatTextSpeedSlider" type="HSlider" parent="Columns/ControlsColumn/CombatTextSpeedGroup"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
size_flags_horizontal = 3
focus_neighbor_bottom = NodePath("../../CombatTextBackgroundGroup/CombatTextBackgroundSlider")
min_value = 25.0
max_value = 200.0
step = 25.0
value = 100.0
tick_count = 8
ticks_on_borders = true
tooltip_text = "Lower values keep words visible longer. Travel distance and battle animation speed are separate."

[node name="CombatTextSpeedGuidance" type="Label" parent="Columns/ControlsColumn/CombatTextSpeedGroup"]
layout_mode = 2
text = "Lower = longer · separate from travel and animation."

[node name="CombatTextBackgroundGroup" type="VBoxContainer" parent="Columns/ControlsColumn"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

