autowrap_mode = 3
horizontal_alignment = 2
theme_override_styles/normal = SubResource("HintGutter")
theme_type_variation = &"VaultStatusMuted"
theme_override_font_sizes/font_size = 12
text = "Current values stay between 0 and their maximum"

[node name="Vitals" type="GridContainer" parent="Content"]
unique_name_in_owner = true
