[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/shared/style/arrow_label.gd" id="1_arrows"]

[node name="SaveEditorChangeRow" type="HBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Text" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Title" type="Label" parent="Text"]
layout_mode = 2
mouse_filter = 1
theme_override_font_sizes/font_size = 14
text = "Title"
text_overrun_behavior = 3

[node name="Detail" type="Label" parent="Text"]
layout_mode = 2
theme_type_variation = &"VaultStatusMuted"
theme_override_font_sizes/font_size = 12
text = "Detail"
text_overrun_behavior = 3

[node name="Arrows" type="HBoxContainer" parent="Text"]
visible = false
layout_mode = 2
script = ExtResource("1_arrows")

[node name="Action" type="Button" parent="."]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"FieldAction"
theme_override_font_sizes/font_size = 13
text = "Action"
