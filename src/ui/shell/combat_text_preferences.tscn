[node name="CombatTextPreview" type="Control" parent="Columns/PreviewColumn"]
custom_minimum_size = Vector2(220, 140)
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
script = ExtResource("2_preview")

[node name="CombatTextPreviewGuidance" type="Label" parent="Columns/PreviewColumn"]
layout_mode = 2
text = "Try these settings before applying them."
autowrap_mode = 2

[node name="CombatTextReset" type="Button" parent="Columns/PreviewColumn"]
custom_minimum_size = Vector2(180, 0)
layout_mode = 2
size_flags_horizontal = 0
focus_neighbor_top = NodePath("../../ControlsColumn/CombatTextOffsetGroup/CombatTextOffsetSlider")
text = "Reset combat text"
tooltip_text = "Restore the combat text defaults in this draft. Apply saves them; Cancel discards them."
