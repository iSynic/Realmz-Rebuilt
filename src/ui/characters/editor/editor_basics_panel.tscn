[node name="Luck" parent="Content/Attributes" instance=ExtResource("2_editor_stat_")]
layout_mode = 2
metadata/field = &"luck"

[node name="VitalsHeader" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Content/VitalsHeader"]
