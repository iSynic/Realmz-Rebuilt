[gd_scene load_steps=3 format=3]
[ext_resource type="PackedScene" path="res://src/ui/screens/screen_frame.tscn" id="1_base"]
[ext_resource type="Script" path="res://src/ui/screens/services_screen.gd" id="2_screen"]
[node name="ServicesScreen" instance=ExtResource("1_base")]
route_id = &"services"
title = "Party Wealth"
description = "Pool, share, and exchange carried wealth."
script = ExtResource("2_screen")

[node name="MoneyColumn" type="VBoxContainer" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="MoneyPoolPanel" type="PanelContainer" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody/MoneyColumn"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"ClassicInset"

[node name="EditorHint" type="Label" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody/MoneyColumn/MoneyPoolPanel"]
layout_mode = 2
text = "Party pool totals and Pool / Share actions"
horizontal_alignment = 1

[node name="MoneyExchangeArea" type="BoxContainer" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody/MoneyColumn"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="MoneyPartyPanel" type="PanelContainer" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody/MoneyColumn/MoneyExchangeArea"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
size_flags_stretch_ratio = 1.12
theme_type_variation = &"ClassicInset"

[node name="EditorHint" type="Label" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody/MoneyColumn/MoneyExchangeArea/MoneyPartyPanel"]
layout_mode = 2
text = "Adventurer wealth list"
horizontal_alignment = 1
vertical_alignment = 1

[node name="MoneySwapPanel" type="PanelContainer" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody/MoneyColumn/MoneyExchangeArea"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_type_variation = &"ClassicInset"

[node name="EditorHint" type="Label" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody/MoneyColumn/MoneyExchangeArea/MoneySwapPanel"]
layout_mode = 2
text = "Selected adventurer exchange controls"
horizontal_alignment = 1
vertical_alignment = 1

[node name="LocationServicesPanel" type="PanelContainer" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody/MoneyColumn"]
visible = false
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"ClassicInset"

[node name="EditorHint" type="Label" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody/MoneyColumn/LocationServicesPanel"]
layout_mode = 2
text = "Services available at the current location"
horizontal_alignment = 1

[node name="ServicesAlternateContent" type="VBoxContainer" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody"]
visible = false
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
