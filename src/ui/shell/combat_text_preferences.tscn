max_value = 100.0
step = 25.0
value = 50.0
tick_count = 5
ticks_on_borders = true
tooltip_text = "At 0%, only outlined words remain."

[node name="CombatTextBackgroundGuidance" type="Label" parent="Columns/ControlsColumn/CombatTextBackgroundGroup"]
