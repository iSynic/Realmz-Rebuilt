[gd_scene load_steps=3 format=3]

[ext_resource type="PackedScene" path="res://src/ui/screens/screen_frame.tscn" id="1_base"]
[ext_resource type="Script" path="res://src/ui/screens/system_screen.gd" id="2_screen"]

[node name="SystemScreen" instance=ExtResource("1_base")]
