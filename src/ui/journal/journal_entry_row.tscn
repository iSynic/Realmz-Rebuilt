[gd_scene format=3]

[node name="JournalEntryRow" type="PanelContainer"]
size_flags_horizontal = 3

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Open" type="Button" parent="Content"]
layout_mode = 2
toggle_mode = true
alignment = 0
text = "Journal entry 0"

[node name="Preview" type="Label" parent="Content"]
layout_mode = 2
text = "Entry preview"
text_overrun_behavior = 3
autowrap_mode = 2
max_lines_visible = 2
