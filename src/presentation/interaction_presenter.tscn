[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/presentation/interaction_presenter.gd" id="1_presenter"]

[node name="InteractionPanel" type="PanelContainer"]
unique_name_in_owner = true
visible = false
z_index = 40
custom_minimum_size = Vector2(320, 280)
theme_type_variation = &"ClassicInset"
script = ExtResource("1_presenter")

[node name="InteractionScroll" type="ScrollContainer" parent="."]
layout_mode = 2
horizontal_scroll_mode = 0
follow_focus = true

[node name="InteractionContent" type="VBoxContainer" parent="InteractionScroll"]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="InteractionHeading" type="Label" parent="InteractionScroll/InteractionContent"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ClassicHeading"
text = "Classic Textbox"

[node name="InteractionPrompt" type="Label" parent="InteractionScroll/InteractionContent"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.93, 0.83, 1)
theme_override_font_sizes/font_size = 20
text = "Choose an option"
autowrap_mode = 2

[node name="InteractionOptions" type="VBoxContainer" parent="InteractionScroll/InteractionContent"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8
