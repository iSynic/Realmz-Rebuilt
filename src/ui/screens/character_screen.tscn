[gd_scene load_steps=3 format=3]

[ext_resource type="PackedScene" path="res://src/ui/screens/screen_frame.tscn" id="1_base"]
[ext_resource type="Script" path="res://src/ui/screens/character_screen.gd" id="2_screen"]

[node name="CharacterScreen" instance=ExtResource("1_base")]
route_id = &"character"
title = "Characters"
description = ""
script = ExtResource("2_screen")

[node name="PartyOrderArea" type="VBoxContainer" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="EditorHint" type="Label" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody/PartyOrderArea"]
layout_mode = 2
text = "Party order summary and optional reorder controls"
horizontal_alignment = 1

[node name="CharacterSheetArea" type="VBoxContainer" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="EditorHint" type="Label" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody/CharacterSheetArea"]
layout_mode = 2
text = "Character selector, identity, tabs, and selected record"
horizontal_alignment = 1
vertical_alignment = 1
