[gd_scene load_steps=3 format=3]

[ext_resource type="PackedScene" path="res://src/ui/screens/screen_frame.tscn" id="1_base"]
[ext_resource type="Script" path="res://src/ui/screens/vault_screen.gd" id="2_screen"]

[node name="VaultScreen" instance=ExtResource("1_base")]
route_id = &"vault"
title = "Character Files"
description = "Reusable characters, revision history, and campaign eligibility."
script = ExtResource("2_screen")

[node name="VaultHeaderArea" type="VBoxContainer" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody"]
unique_name_in_owner = true
layout_mode = 2

[node name="EditorHint" type="Label" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody/VaultHeaderArea"]
layout_mode = 2
text = "Character Files navigation and totals"
horizontal_alignment = 2

[node name="VaultListArea" type="VBoxContainer" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="EditorHint" type="Label" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody/VaultListArea"]
layout_mode = 2
text = "Current reusable character records"
horizontal_alignment = 1
vertical_alignment = 1

[node name="VaultHistoryArea" type="VBoxContainer" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="EditorHint" type="Label" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody/VaultHistoryArea"]
layout_mode = 2
text = "Revision history and archives"
horizontal_alignment = 1

[node name="VaultInspectionArea" type="VBoxContainer" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="EditorHint" type="Label" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody/VaultInspectionArea"]
layout_mode = 2
text = "Selected immutable character revision"
horizontal_alignment = 1
vertical_alignment = 1
