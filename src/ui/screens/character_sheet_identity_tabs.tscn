[gd_scene format=3]

[node name="CharacterSheetIdentityTabs" type="VBoxContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="AppearanceTab" type="VBoxContainer" parent="."]
layout_mode = 2
