[gd_scene format=3]

[node name="KeyboardReference" type="TabContainer"]
layout_mode = 2
size_flags_horizontal = 3
clip_tabs = true

[node name="General" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Table" type="GridContainer" parent="General"]
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 28
theme_override_constants/v_separation = 5

[node name="Action0" type="Label" parent="General/Table"]
