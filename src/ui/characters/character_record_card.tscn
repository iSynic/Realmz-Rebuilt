[gd_scene format=3]

[node name="CharacterRecordCard" type="PanelContainer"]
size_flags_horizontal = 3
theme_type_variation = &"ClassicInset"

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2
[node name="Title" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"ClassicHeading"
theme_override_colors/font_color = Color(0.835294, 0.705882, 0.364706, 1)
theme_override_font_sizes/font_size = 16
[node name="Subtitle" type="Label" parent="Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.878431, 0.886275, 0.898039, 1)
theme_override_font_sizes/font_size = 14
[node name="Detail" type="Label" parent="Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.604, 0.627, 0.659, 1)
autowrap_mode = 2
