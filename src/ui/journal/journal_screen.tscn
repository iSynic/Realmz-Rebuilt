[gd_scene load_steps=4 format=3]

[ext_resource type="PackedScene" path="res://src/ui/shared/screen_frame.tscn" id="1_base"]
[ext_resource type="Script" path="res://src/ui/journal/journal_screen.gd" id="2_screen"]
[ext_resource type="PackedScene" path="res://src/ui/journal/maps_notes_workspace.tscn" id="3_workspace"]

[node name="JournalScreen" instance=ExtResource("1_base")]
route_id = &"journal"
title = "Maps / Notes"
description = "Acquired maps, scenario notes, and player-facing history."
script = ExtResource("2_screen")

[node name="MapsNotesWorkspace" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody" instance=ExtResource("3_workspace")]
layout_mode = 2

[node name="JournalAlternateContent" type="VBoxContainer" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
