custom_minimum_size = Vector2(230, 0)
layout_mode = 2
text = "Scrolling combat text speed"
[node name="CombatTextSpeedSlider" type="HSlider" parent="PacingSettingsScroll/PacingSettingsPanel/Content/CombatTextSpeedRow"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 25.0
max_value = 200.0
step = 25.0
tick_count = 8
ticks_on_borders = true
[node name="CombatTextExplanation" type="Label" parent="PacingSettingsScroll/PacingSettingsPanel/Content"]
layout_mode = 2
text = "Lower values keep damage and status words visible longer. Battle animations keep their own speed."
autowrap_mode = 2
[node name="CombatTextBackgroundRow" type="BoxContainer" parent="PacingSettingsScroll/PacingSettingsPanel/Content" groups=["system_setting_rows"]]
layout_mode = 2
[node name="CombatTextBackgroundCaption" type="Label" parent="PacingSettingsScroll/PacingSettingsPanel/Content/CombatTextBackgroundRow"]
