[gd_scene format=3]

[node name="TreasureRecoveryWorkspace" type="VBoxContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 6

[node name="TreasureWorkspaceHeader" type="HBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
[node name="TreasureWorkspaceTitle" type="Label" parent="TreasureWorkspaceHeader"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"ClassicHeading"
text = "Recover Fumbled Item"
[node name="TreasureWorkspaceSummary" type="Label" parent="TreasureWorkspaceHeader"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.561, 0.812, 0.82, 1)
horizontal_alignment = 2

[node name="TreasureWorkspaceColumns" type="HBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="TreasureItemColumn" type="PanelContainer" parent="TreasureWorkspaceColumns"]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
size_flags_stretch_ratio = 1.2
theme_type_variation = &"ClassicInset"
[node name="Content" type="VBoxContainer" parent="TreasureWorkspaceColumns/TreasureItemColumn"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 5
[node name="Heading" type="Label" parent="TreasureWorkspaceColumns/TreasureItemColumn/Content"]
layout_mode = 2
theme_type_variation = &"ClassicHeading"
text = "Dropped Item"
[node name="TreasureLootField" type="CenterContainer" parent="TreasureWorkspaceColumns/TreasureItemColumn/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 132)
layout_mode = 2
size_flags_horizontal = 3
[node name="Stage" type="Control" parent="TreasureWorkspaceColumns/TreasureItemColumn/Content/TreasureLootField"]
custom_minimum_size = Vector2(130, 124)
layout_mode = 2
[node name="TreasureItemGlow" type="TextureRect" parent="TreasureWorkspaceColumns/TreasureItemColumn/Content/TreasureLootField/Stage"]
unique_name_in_owner = true
offset_left = 17.0
offset_top = 14.0
offset_right = 113.0
offset_bottom = 110.0
mouse_filter = 2
texture_filter = 1
expand_mode = 1
stretch_mode = 5
[node name="TreasureItemIcon" type="TextureRect" parent="TreasureWorkspaceColumns/TreasureItemColumn/Content/TreasureLootField/Stage"]
unique_name_in_owner = true
offset_left = 11.0
offset_top = 8.0
offset_right = 119.0
offset_bottom = 116.0
mouse_filter = 2
texture_filter = 1
expand_mode = 1
stretch_mode = 5
[node name="TreasureItemIconUnavailable" type="Label" parent="TreasureWorkspaceColumns/TreasureItemColumn/Content/TreasureLootField/Stage"]
unique_name_in_owner = true
visible = false
offset_left = 11.0
offset_top = 8.0
offset_right = 119.0
offset_bottom = 116.0
theme_override_colors/font_color = Color(0.682, 0.714, 0.729, 1)
text = "◇"
horizontal_alignment = 1
vertical_alignment = 1
[node name="TreasureSelectionCircle" type="TextureRect" parent="TreasureWorkspaceColumns/TreasureItemColumn/Content/TreasureLootField/Stage"]
unique_name_in_owner = true
offset_left = 15.0
offset_top = 2.0
offset_right = 115.0
offset_bottom = 122.0
mouse_filter = 2
texture_filter = 1
expand_mode = 1
stretch_mode = 5

[node name="TreasureSelectedItem" type="PanelContainer" parent="TreasureWorkspaceColumns/TreasureItemColumn/Content"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"ClassicInset"
[node name="Facts" type="VBoxContainer" parent="TreasureWorkspaceColumns/TreasureItemColumn/Content/TreasureSelectedItem"]
layout_mode = 2
theme_override_constants/separation = 2
[node name="TreasureSelectedItemName" type="Label" parent="TreasureWorkspaceColumns/TreasureItemColumn/Content/TreasureSelectedItem/Facts"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ClassicHeading"
autowrap_mode = 2
[node name="TreasureSelectedItemState" type="Label" parent="TreasureWorkspaceColumns/TreasureItemColumn/Content/TreasureSelectedItem/Facts"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.561, 0.812, 0.82, 1)
[node name="TreasureSelectedItemCharges" type="Label" parent="TreasureWorkspaceColumns/TreasureItemColumn/Content/TreasureSelectedItem/Facts"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.682, 0.714, 0.729, 1)
autowrap_mode = 2
[node name="TreasureRemainingItems" type="Label" parent="TreasureWorkspaceColumns/TreasureItemColumn/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.898, 0.769, 0.361, 1)
autowrap_mode = 2
[node name="TreasurePrompt" type="Label" parent="TreasureWorkspaceColumns/TreasureItemColumn/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.682, 0.714, 0.729, 1)
autowrap_mode = 2

[node name="TreasureRecipientColumn" type="PanelContainer" parent="TreasureWorkspaceColumns"]
custom_minimum_size = Vector2(220, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_type_variation = &"ClassicInset"
[node name="Content" type="VBoxContainer" parent="TreasureWorkspaceColumns/TreasureRecipientColumn"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 5
[node name="Heading" type="Label" parent="TreasureWorkspaceColumns/TreasureRecipientColumn/Content"]
layout_mode = 2
theme_type_variation = &"ClassicHeading"
text = "Recover To"
[node name="TreasureRecipientHint" type="Label" parent="TreasureWorkspaceColumns/TreasureRecipientColumn/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.682, 0.714, 0.729, 1)
text = "Choose an eligible adventurer to recover this exact item."
autowrap_mode = 2
[node name="TreasureRecipientScroll" type="ScrollContainer" parent="TreasureWorkspaceColumns/TreasureRecipientColumn/Content"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0
[node name="TreasureRecoveryRecipientRows" type="VBoxContainer" parent="TreasureWorkspaceColumns/TreasureRecipientColumn/Content/TreasureRecipientScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 3
[node name="TreasureNoRecipients" type="Label" parent="TreasureWorkspaceColumns/TreasureRecipientColumn/Content/TreasureRecipientScroll/TreasureRecoveryRecipientRows"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.682, 0.714, 0.729, 1)
text = "No recipient is available."
autowrap_mode = 2

[node name="TreasureFooter" type="HBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6
[node name="TreasureLeaveItem" type="Button" parent="TreasureFooter"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 0)
layout_mode = 2
text = "Leave Item"
[node name="Spacer" type="Control" parent="TreasureFooter"]
layout_mode = 2
size_flags_horizontal = 3
