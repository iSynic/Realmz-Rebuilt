[node name="CombatTextOffsetGuidance" type="Label" parent="Columns/ControlsColumn/CombatTextOffsetGroup"]
layout_mode = 2
text = "Logical map px · −64 to +64 · step 2 · negative Y moves up."

[node name="CombatTextOffsetStateGuidance" type="Label" parent="Columns/ControlsColumn/CombatTextOffsetGroup"]
layout_mode = 2
