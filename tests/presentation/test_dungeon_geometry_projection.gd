extends RealmzTestCase


func run() -> void:
	var party_rect := Rect2(64, 64, 32, 32)
	assert_equal(ClassicMapPresenter.land_direction_at(Vector2(130, 20), party_rect), Vector2i(1, -1), "land clicks beyond both party-cell axes request northeast movement"); assert_equal(ClassicMapPresenter.land_direction_at(Vector2(20, 130), party_rect), Vector2i(-1, 1), "land clicks beyond both party-cell axes request southwest movement")
	assert_equal(ClassicMapPresenter.land_direction_at(Vector2(80, 20), party_rect), Vector2i.UP, "land clicks aligned with the party column remain cardinal"); assert_equal([ClassicMapPresenter.movement_cursor_asset_id(Vector2i(-1, -1)), ClassicMapPresenter.movement_cursor_asset_id(Vector2i.UP), ClassicMapPresenter.movement_cursor_asset_id(Vector2i(1, -1)), ClassicMapPresenter.movement_cursor_asset_id(Vector2i.LEFT), ClassicMapPresenter.movement_cursor_asset_id(Vector2i.ZERO), ClassicMapPresenter.movement_cursor_asset_id(Vector2i.RIGHT), ClassicMapPresenter.movement_cursor_asset_id(Vector2i(-1, 1)), ClassicMapPresenter.movement_cursor_asset_id(Vector2i.DOWN), ClassicMapPresenter.movement_cursor_asset_id(Vector2i.ONE)], [&"map.cursor.northwest", &"map.cursor.north", &"map.cursor.northeast", &"map.cursor.west", &"map.cursor.center", &"map.cursor.east", &"map.cursor.southwest", &"map.cursor.south", &"map.cursor.southeast"], "Classic land pointer regions select exact color-cursor identities"); assert_equal(ClassicUiAssetCatalog.cursor_hotspot(&"map.cursor.east"), Vector2(14, 7), "the exact east cursor retains Castle's authored hotspot"); assert_true(ClassicUiAssetCatalog.texture(&"map.cursor.east") != null, "the exact application-owned east cursor is available to exploration"); assert_equal([ClassicMapPresenter.boat_marker_asset_id(0, false), ClassicMapPresenter.boat_marker_asset_id(0, true), ClassicMapPresenter.boat_marker_asset_id(9, true)], [&"map.party.boat.left.0", &"map.party.boat.right.0", &""], "Castle's available landlook-specific boat CICNs replace the mounted marker without inventing absent variants"); assert_true(ClassicUiAssetCatalog.texture(&"map.party.boat.left.0") != null and ClassicUiAssetCatalog.texture(&"map.party.boat.right.0") != null, "War's exact left and right boat markers are available to exploration")

	assert_equal(ClassicMapPresenter.camera_top_left(Vector2i(48, 15), Vector2i(90, 90), Vector2i(16, 13)), Vector2i(40, 9), "native Classic cells center the AOGM start within the bounded map viewport")
	assert_equal(ClassicMapPresenter.camera_top_left(Vector2i.ZERO, Vector2i(90, 90), Vector2i(16, 13)), Vector2i.ZERO, "exploration camera clamps at the north-west map boundary")
	assert_equal(ClassicMapPresenter.camera_top_left(Vector2i(89, 89), Vector2i(90, 90), Vector2i(16, 13)), Vector2i(74, 77), "exploration camera clamps at the south-east map boundary")
	assert_equal([ClassicMapPresenter.dungeon_party_marker_region(1), ClassicMapPresenter.dungeon_party_marker_region(2), ClassicMapPresenter.dungeon_party_marker_region(3), ClassicMapPresenter.dungeon_party_marker_region(4)], [Rect2(0, 0, 16, 16), Rect2(16, 0, 16, 16), Rect2(32, 0, 16, 16), Rect2(48, 0, 16, 16)], "Castle's PICT 302 party arrows follow the four authoritative dungeon headings")
	assert_equal(ClassicUiAssetCatalog.native_size(ClassicMapPresenter.DUNGEON_PARTY_ARROWS_ASSET_ID), Vector2i(64, 16), "the exact four-frame dungeon arrow strip remains available at its authored size")
	var dungeon_arrow := ClassicMapPresenter.dungeon_party_marker_texture(ClassicUiAssetCatalog.texture(ClassicMapPresenter.DUNGEON_PARTY_ARROWS_ASSET_ID), 1).get_image()
	assert_true(dungeon_arrow.get_pixel(0, 0).a == 0.0 and dungeon_arrow.get_pixel(8, 1).is_equal_approx(Color(85.0 / 255.0, 85.0 / 255.0, 85.0 / 255.0, 1.0)), "Castle's transparent CopyBits matte is removed while the authored grayscale arrow remains opaque")
	var maximized_cells := ClassicMapPresenter.viewport_cells_for(Vector2(1780, 610), 24.0, 32.0)
	assert_equal(maximized_cells, Vector2i(55, 18), "maximized layouts use every complete native cell available to the revealed map window")
	var maximized_origin := ClassicMapPresenter.map_draw_origin_for(Vector2(1780, 610), Vector2(0, 24), 32.0, maximized_cells)
	assert_equal(maximized_origin, Vector2(10, 29), "the expanded map viewport is centered in the maximized stage")
	var first_coordinate := Vector2i(50, 15)
	var later_coordinate := Vector2i(60, 15)
	var first_camera := ClassicMapPresenter.camera_top_left(first_coordinate, Vector2i(90, 90), maximized_cells)
	var later_camera := ClassicMapPresenter.camera_top_left(later_coordinate, Vector2i(90, 90), maximized_cells)
	var first_party_rect := Rect2(maximized_origin + Vector2(first_coordinate - first_camera) * 32.0, Vector2.ONE * 32.0)
	var later_party_rect := Rect2(maximized_origin + Vector2(later_coordinate - later_camera) * 32.0, Vector2.ONE * 32.0)
	assert_equal(later_party_rect, first_party_rect, "overworld movement scrolls map contents without moving the maximized viewport")
	var cells: Array[MapCellView] = [
		_cell(Vector2i.ZERO, true, true, [&"stairs"], {&"north": &"wall", &"east": &"archway", &"south": &"open", &"west": &"map-boundary"}, {&"north": false, &"east": true, &"south": true, &"west": false}),
		_cell(Vector2i.RIGHT, true, true, [&"column", &"door"], {&"north": &"door", &"east": &"door", &"south": &"door", &"west": &"door"}, {&"north": false, &"east": false, &"south": false, &"west": true}),
		_cell(Vector2i.DOWN, true, false, [], {&"north": &"open", &"east": &"wall", &"south": &"wall", &"west": &"wall"}, {&"north": true, &"east": false, &"south": false, &"west": false}),
	]
	var dungeon_view := MapView.new("dungeon:test", "Projection Test", &"dungeon", 2, 2, Vector2i.ZERO, cells); dungeon_view.last_move_direction = Vector2i.RIGHT; dungeon_view.dungeon_heading = 2
	var projection := DungeonGeometryProjection.from_map_view(dungeon_view)
	assert_not_null(projection, "dungeon MapView produces a disposable 3D projection"); assert_equal([projection.heading, projection.facing_direction], [2, Vector2i.RIGHT], "the first-person projection faces the authoritative Classic heading"); var mesh_builder: GDScript = load("res://src/presentation/dungeon_scene_mesh_builder.gd"); var scene_mesh: ArrayMesh = mesh_builder.build(projection, load("res://src/presentation/assets/classic-dungeon/classic-dungeon-atlas.png")); var scene_arrays := scene_mesh.surface_get_arrays(0); var scene_normals: PackedVector3Array = scene_arrays[Mesh.ARRAY_NORMAL]; var scene_uvs: PackedVector2Array = scene_arrays[Mesh.ARRAY_TEX_UV]; var material := scene_mesh.surface_get_material(0) as ShaderMaterial; var door_top_vertex_count := Array(scene_uvs).filter(func(uv: Vector2) -> bool: return is_equal_approx(uv.y, 144.0 / 512.0)).size(); assert_equal(door_top_vertex_count, 6, "repeated source door edges still emit exactly one non-indexed two-sided cell-oriented door"); assert_true(scene_mesh != null and scene_mesh.get_surface_count() == 1 and not scene_uvs.is_empty() and material != null and material.shader.code.contains("unshaded") and material.shader.code.contains("vec3(0.94, 1.06, 0.92)") and material.shader.code.contains("CAMERA_POSITION_WORLD") and material.shader.code.contains("ALBEDO = mac_color * shade") and material.get_shader_parameter("scene_brightness") == 1.0 and not Array(scene_uvs).any(func(uv: Vector2) -> bool: return uv.x > 0.625 and uv.x < 0.75) and Array(scene_uvs).any(func(uv: Vector2) -> bool: return uv.x >= 2.0 and is_equal_approx(uv.y, 0.25)) and mesh_builder.ARCHWAY_OPENING_WIDTH == 0.64 and Array(scene_normals).any(func(normal: Vector3) -> bool: return normal.y > 0.99) and Array(scene_normals).any(func(normal: Vector3) -> bool: return normal.y < -0.99) and Array(scene_normals).any(func(normal: Vector3) -> bool: return normal.z > 0.99) and mesh_builder.floor_tile_uv(Vector2i(4, 5)).size == Vector2(128, 128) and projection.cell_at(Vector2i.RIGHT).feature_orientation(&"door") == &"vertical" and mesh_builder.cell_door_center(Vector2i.RIGHT, true) == Vector3(0.5, 0.0, 0.0) and mesh_builder.boundary_color(Vector2i.ZERO, Vector2i.RIGHT) == mesh_builder.boundary_color(Vector2i(0, 1), Vector2i.RIGHT), "the donor renderer batches hue-stable yellow-sand floors, ceilings, occluding walls, and broad-brick archways plus one entry-plane-flush oriented door, stair, and textured pillar geometry with camera-relative shading and one stable square surface tile per world cell"); assert_equal([DungeonMap3DPresenter.relative_movement(2, &"forward"), DungeonMap3DPresenter.relative_movement(2, &"reverse"), DungeonMap3DPresenter.turn_delta(&"turn_left"), DungeonGeometryProjection.rotated_heading(1, -1), mesh_builder.boundary_allows_movement(projection, Vector2i.ZERO, &"east"), ClassicMapPresenter.dungeon_discovery_coordinates([Vector2i(4, 5)]).has(Vector2i(5, 6)), ClassicMapPresenter.dungeon_discovery_coordinates([Vector2i(4, 5)]).has(Vector2i(6, 6))], [Vector2i.RIGHT, Vector2i.LEFT, -1, 4, false, true, false], "first-person navigation stays heading-relative, door orientation survives projection, and 2D discovery expands only one square around the save-owned walked path")
	var retained_coordinates := {Vector2i.ZERO: true}; var retained_mesh: ArrayMesh = mesh_builder.build_world_batch(projection, load("res://src/presentation/assets/classic-dungeon/classic-dungeon-atlas.png"), retained_coordinates, {}, {}); assert_true(retained_mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX].size() < scene_arrays[Mesh.ARRAY_VERTEX].size(), "an ordinary retained movement patch emits only its entering coordinates instead of rebuilding the complete dungeon window")
	var deferred_wall_cells: Array[MapCellView] = [_cell(Vector2i.ZERO, true, true, [], {&"north": &"wall", &"east": &"open", &"south": &"wall", &"west": &"wall"}, {&"north": false, &"east": true, &"south": false, &"west": false}), _cell(Vector2i.RIGHT, false, true, [], {&"north": &"wall", &"east": &"wall", &"south": &"wall", &"west": &"wall"}, {&"north": false, &"east": false, &"south": false, &"west": false})]
	var deferred_wall_view := MapView.new("dungeon:deferred-wall", "Deferred Wall", &"dungeon", 2, 1, Vector2i.ZERO, deferred_wall_cells); var deferred_wall_projection := DungeonGeometryProjection.from_map_view(deferred_wall_view); var deferred_wall_mesh: ArrayMesh = mesh_builder.build_world_batch(deferred_wall_projection, load("res://src/presentation/assets/classic-dungeon/classic-dungeon-atlas.png"), {Vector2i.RIGHT: true}, {}, {}); var deferred_wall_vertices: PackedVector3Array = deferred_wall_mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX]
	assert_true(deferred_wall_vertices.size() == 6 and Array(deferred_wall_vertices).all(func(vertex: Vector3) -> bool: return is_equal_approx(vertex.x, 0.5)), "an entering impassable cell completes the retained boundary deferred when its adjacent floor entered first")
	assert_true(DungeonMap3DPresenter.transition_duration(DungeonMap3DPresenter.MOVE_TWEEN_SECONDS, 400) < DungeonMap3DPresenter.transition_duration(DungeonMap3DPresenter.MOVE_TWEEN_SECONDS, 100) and DungeonMap3DPresenter.transition_duration(DungeonMap3DPresenter.TURN_TWEEN_SECONDS, 25) == 0.0 and DungeonMap3DPresenter.camera_position_for(Vector2i(4, 7)) == Vector3(4.0, 0.72, 7.0), "the saved exploration speed scales forward and reverse camera motion, while Classic heading changes snap immediately and retained world geometry uses authoritative dungeon coordinates")
	assert_true(absf(mesh_builder.DOOR_UV.size.aspect() - 0.72 / 1.23) < 0.01 and ClassicMapPresenter.requires_los_blackout(cells) and ClassicMapPresenter.land_marker_tile_ids(_cell(Vector2i(2, 2), true, true, [&"secret", &"discovered_path"], {}, {})) == [251, 253] and ClassicMapPresenter.darkness_mask_rect(Rect2(160, 160, 32, 32)) == Rect2(0, 0, 320, 320) and ClassicMapPresenter.darkness_mask_asset_id(9) == "classic-darkness-mask-6", "the door preserves round texture geometry while LOS blackout, discovery overlays, and the fixed Classic darkness mask consume detached facts")
	var marker_atlas := MediaAsset.new("fixture-battle-atlas", "Fixture", "battle-tileset", "image/png", "", 0, 1, "0".repeat(64), "", 640, 640, 0, 0, 0, 32, 32, 20, 20, -1, -1); var marker_source := Image.create(640, 640, false, Image.FORMAT_RGBA8); marker_source.fill(Color.BLACK); var marker_region := marker_atlas.region_for(251); marker_source.fill_rect(marker_region, Color.WHITE); marker_source.set_pixelv(marker_region.position + Vector2i.ONE, Color.RED); var transparent_marker := ClassicRetainedMapSurface.transparent_marker_tile(marker_atlas, ImageTexture.create_from_image(marker_source), 251); var transparent_marker_image := transparent_marker.get_image(); assert_true(transparent_marker_image.get_pixelv(Vector2i.ZERO).a == 0.0 and transparent_marker_image.get_pixelv(Vector2i.ONE).is_equal_approx(Color.RED), "retained land markers discard Castle's white transfer background while preserving the colored S pixels above the authored terrain")
	assert_equal(projection.map_id, dungeon_view.map_id, "projection retains only detached view identity")
	assert_equal(projection.cells().size(), 2, "only topology-visible cells become presentation geometry")
	assert_equal(projection.edges().size(), 8, "every visible directed topology edge is preserved for equivalence checks")
	for source: MapCellView in dungeon_view.cells():
		assert_equal(source.render_tile, 1, "detached presentation cells retain their immutable render tile")
		assert_equal(source.tileset_id, "dungeon-top-down-302", "detached presentation cells retain their immutable tileset identity")
		if not source.visible:
			assert_equal(projection.cell_at(source.coordinate), null, "hidden cells cannot leak into dungeon geometry")
			continue
		var projected_cell := projection.cell_at(source.coordinate)
		assert_not_null(projected_cell, "visible topology cell has one 3D projection cell")
		assert_equal(projected_cell.passable, source.passable, "2D and 3D consume the same cell passability fact")
		assert_equal(projected_cell.blocks_los, source.blocks_los, "2D and 3D consume the same LOS fact")
		assert_equal(projected_cell.features, source.features(), "2D and 3D consume the same feature facts")
		for direction: StringName in DungeonGeometryProjection.DIRECTIONS:
			var edge := projection.edge_at(source.coordinate, direction)
			assert_not_null(edge, "visible directed edge has one projection fact")
			assert_equal(edge.kind, source.edge_kind(direction), "3D edge kind equals the authoritative detached view")
			assert_equal(edge.passable, source.edge_is_passable(direction), "3D edge passability equals the authoritative detached view")
	var east := projection.edge_at(Vector2i.ZERO, &"east")
	var west := projection.edge_at(Vector2i.RIGHT, &"west")
	assert_equal(east.canonical_key, west.canonical_key, "opposite directed facts share one render-cache edge identity")
	var land_view := MapView.new("land:test", "Land", &"land", 1, 1, Vector2i.ZERO, [_cell(Vector2i.ZERO, true, true, [], {}, {})])
	assert_equal(DungeonGeometryProjection.from_map_view(land_view), null, "the optional 3D presenter cannot create a second land-map model")


func _cell(coordinate: Vector2i, passable: bool, visible: bool, features: Array[StringName], edge_kinds: Dictionary, edge_passability: Dictionary) -> MapCellView:
	return MapCellView.new(coordinate, "classic.terrain.test", 1, "dungeon-top-down-302", passable, false, visible, visible, false, false, features, {&"door": &"vertical"} if features.has(&"door") else {}, edge_kinds, edge_passability)
