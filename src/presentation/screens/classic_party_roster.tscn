[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/presentation/screens/classic_party_roster.gd" id="1_roster"]

[node name="ClassicPartyRoster" type="PanelContainer"]
theme_type_variation = &"ClassicInset"
clip_contents = true
