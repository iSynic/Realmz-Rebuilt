[gd_scene format=3]

[node name="FastSpellRow" type="PanelContainer"]
size_flags_horizontal = 3
theme_type_variation = &"ClassicInset"

[node name="Content" type="BoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="Slot" type="Label" parent="Content"]
custom_minimum_size = Vector2(52, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.835294, 0.705882, 0.364706, 1)
theme_override_font_sizes/font_size = 13
text = "Slot 1"
vertical_alignment = 1

[node name="Picker" type="OptionButton" parent="Content"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"ClassicTheldrowOptionButton"
fit_to_longest_item = false

[node name="Clear" type="Button" parent="Content"]
custom_minimum_size = Vector2(56, 34)
layout_mode = 2
text = "Clear"
