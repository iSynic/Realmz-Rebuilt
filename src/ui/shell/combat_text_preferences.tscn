[ext_resource type="Script" path="res://src/ui/shell/combat_text_preferences_preview.gd" id="2_preview"]

[node name="CombatTextPreferences" type="MarginContainer"]
custom_minimum_size = Vector2(0, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8
script = ExtResource("1_panel")

[node name="Columns" type="BoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
vertical = false
theme_override_constants/separation = 16

[node name="ControlsColumn" type="VBoxContainer" parent="Columns"]
custom_minimum_size = Vector2(0, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 7

[node name="CombatTextHeading" type="Label" parent="Columns/ControlsColumn"]
layout_mode = 2
text = "Combat text"
theme_override_font_sizes/font_size = 26

[node name="CombatTextSpeedGroup" type="VBoxContainer" parent="Columns/ControlsColumn"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="CombatTextSpeedRow" type="BoxContainer" parent="Columns/ControlsColumn/CombatTextSpeedGroup" groups=["system_setting_rows"]]
layout_mode = 2
