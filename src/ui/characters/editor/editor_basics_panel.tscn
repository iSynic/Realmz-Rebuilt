[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/characters/editor/editor_basics_panel.gd" id="1_editor_basic"]
[ext_resource type="PackedScene" path="res://src/ui/characters/editor/editor_stat_stepper.tscn" id="2_editor_stat_"]
[ext_resource type="StyleBox" path="res://src/ui/characters/vault_styles/field_tile.tres" id="3_field_tile"]

[sub_resource type="StyleBoxEmpty" id="HintGutter"]
content_margin_right = 16.0

[node name="EditorBasicsPanel" type="ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 1
follow_focus = true
script = ExtResource("1_editor_basic")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="AttributesHeader" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Content/AttributesHeader"]
layout_mode = 2
theme_type_variation = &"MenuHeading"
theme_override_font_sizes/font_size = 18
text = "Attributes"

[node name="Spacer" type="Control" parent="Content/AttributesHeader"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Caption" type="Label" parent="Content/AttributesHeader"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3
horizontal_alignment = 2
theme_override_styles/normal = SubResource("HintGutter")
theme_type_variation = &"VaultStatusMuted"
theme_override_font_sizes/font_size = 12
text = "Brawn + magic strength ≤ 57 keeps load in range"

[node name="Attributes" type="GridContainer" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
columns = 6
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="Brawn" parent="Content/Attributes" instance=ExtResource("2_editor_stat_")]
layout_mode = 2
metadata/field = &"brawn"

[node name="Knowledge" parent="Content/Attributes" instance=ExtResource("2_editor_stat_")]
layout_mode = 2
metadata/field = &"knowledge"

[node name="Judgment" parent="Content/Attributes" instance=ExtResource("2_editor_stat_")]
