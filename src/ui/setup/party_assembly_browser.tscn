[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/ui/setup/party_assembly_browser.gd" id="1_browser"]
[ext_resource type="PackedScene" path="res://src/ui/setup/party_setup_character_row.tscn" id="2_row"]
[ext_resource type="StyleBox" path="res://src/ui/characters/vault_styles/rule_line.tres" id="st_rule"]

[node name="PartyAssemblyBrowser" type="VBoxContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 8
script = ExtResource("1_browser")
character_row_scene = ExtResource("2_row")

[node name="CharacterFilesHeading" type="MarginContainer" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 28)
layout_mode = 2

[node name="HeadingContent" type="BoxContainer" parent="CharacterFilesHeading"]
layout_mode = 2

[node name="Heading" type="Label" parent="CharacterFilesHeading/HeadingContent"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"VaultStatusGold"
theme_override_font_sizes/font_size = 22
text = "Character Files"

[node name="CharacterFileCount" type="Label" parent="CharacterFilesHeading/HeadingContent"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"VaultStatusMuted"
theme_override_font_sizes/font_size = 14
text = "0 can join"

[node name="AssemblyCampaignContext" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Choose a scenario to add characters"
autowrap_mode = 3
theme_type_variation = &"VaultStatusMuted"
theme_override_font_sizes/font_size = 14

[node name="ContextRule" type="Panel" parent="."]
custom_minimum_size = Vector2(0, 1)
layout_mode = 2
theme_override_styles/panel = ExtResource("st_rule")

[node name="StoredCharacterList" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="CharacterFilesEmpty" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"VaultStatusMuted"
theme_override_font_sizes/font_size = 15
text = "No Character Files yet. Create one here."
autowrap_mode = 2

[node name="CharacterFilePager" type="HBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="CharacterFilePrevious" type="Button" parent="CharacterFilePager"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 26)
layout_mode = 2
theme_type_variation = &"CompactAction"
theme_override_font_sizes/font_size = 14
text = "Previous"

[node name="CharacterFilePage" type="Label" parent="CharacterFilePager"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"VaultStatusMuted"
theme_override_font_sizes/font_size = 14
text = "Page 1 of 1"
horizontal_alignment = 1

[node name="CharacterFileNext" type="Button" parent="CharacterFilePager"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 26)
layout_mode = 2
theme_type_variation = &"CompactAction"
theme_override_font_sizes/font_size = 14
text = "Next"
