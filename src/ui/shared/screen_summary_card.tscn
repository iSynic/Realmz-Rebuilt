[gd_scene format=3]

[node name="ScreenSummaryCard" type="PanelContainer"]
custom_minimum_size = Vector2(280, 0)
size_flags_horizontal = 3
theme_type_variation = &"ClassicInset"

[node name="SummaryContent" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 3

[node name="SummaryTitle" type="Label" parent="SummaryContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.905882, 0.815686, 0.470588, 1)
theme_override_font_sizes/font_size = 17
text = "Summary"
autowrap_mode = 2

[node name="SummarySubtitle" type="Label" parent="SummaryContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.878431, 0.886275, 0.898039, 1)
theme_override_font_sizes/font_size = 15
text = "Screen summary"
autowrap_mode = 2

[node name="SummaryDetail" type="Label" parent="SummaryContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.603922, 0.627451, 0.658824, 1)
theme_override_font_sizes/font_size = 15
text = "Additional details"
autowrap_mode = 2
