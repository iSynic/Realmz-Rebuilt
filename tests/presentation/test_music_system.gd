extends RealmzTestCase

func run() -> void:
	_test_music_system()

func _test_music_system() -> void:
	var application_media := ApplicationMediaCatalog.new(); var stock_media := ClassicMediaCatalog.new(null, application_media); assert_true(application_media.is_valid() and [0, 3, 4, 5, 9, 10].all(func(landlook: int) -> bool: return stock_media.tileset_by_id("landlook-%d" % landlook) != null) and stock_media.tileset_by_id("landlook-10").region_for(155).has_area() and stock_media.image_texture(stock_media.tileset_by_id("landlook-10")) != null, "the application fallback decodes every stock landlook atlas needed by exploration and active-landlook combat")
	var settings := PresentationSettings.new(); settings.sound_volume = 0.65; settings.music_volume = 0.4; settings.music_enabled = false; assert_true(settings.set_music_mode(1, PresentationSettings.MUSIC_CONTINUE) and settings.set_music_mode(17, PresentationSettings.MUSIC_OFF) and not settings.set_music_mode(21, PresentationSettings.MUSIC_PLAY), "playlist mutation accepts only Castle's twenty slots and three modes"); var restored := PresentationSettings.from_data(settings.to_data()); assert_not_null(restored, "schema-eight music preferences round-trip"); assert_equal([restored.sound_volume, restored.music_volume, restored.music_enabled, restored.music_mode(1), restored.music_mode(17), restored.music_mode(21)], [0.65, 0.4, false, PresentationSettings.MUSIC_CONTINUE, PresentationSettings.MUSIC_OFF, PresentationSettings.MUSIC_OFF], "effects, music, valid modes, and safe out-of-range lookup persist independently"); var legacy := settings.to_data(); legacy["schemaVersion"] = 7; legacy.erase("soundVolume"); legacy.erase("musicVolume"); legacy.erase("musicEnabled"); legacy.erase("musicPlaylistModes"); var migrated := PresentationSettings.from_data(legacy); assert_equal([migrated.sound_volume, migrated.music_volume, migrated.music_enabled, migrated.music_playlist_modes.size(), migrated.music_playlist_modes.all(func(mode: int) -> bool: return mode == PresentationSettings.MUSIC_PLAY)], [1.0, 0.8, true, 20, true], "schema-seven preferences receive stable audio and Play defaults"); var malformed := settings.to_data(); malformed["musicPlaylistModes"] = [PresentationSettings.MUSIC_PLAY]; assert_equal(PresentationSettings.from_data(malformed), null, "current preferences reject an incomplete playlist"); malformed = settings.to_data(); malformed["musicPlaylistModes"][4] = 9; assert_equal(PresentationSettings.from_data(malformed), null, "current preferences reject unknown playlist modes"); var settings_path := "user://realmz2-tests/music-settings.json"; var repository := SettingsRepository.new(settings_path); assert_true(repository.save_settings(settings), "music preferences commit outside the adventure save"); var loaded := repository.load_settings(); assert_equal([loaded.music_mode(1), loaded.music_mode(17), loaded.music_enabled, loaded.music_volume], [PresentationSettings.MUSIC_CONTINUE, PresentationSettings.MUSIC_OFF, false, 0.4], "the host repository restores the complete playlist state"); DirAccess.remove_absolute(ProjectSettings.globalize_path(settings_path)); DirAccess.remove_absolute(ProjectSettings.globalize_path(settings_path + ".tmp")); var catalog := ClassicMusicCatalog.new(); assert_true(catalog.is_valid() and catalog.has_track(11) and catalog.has_track(12) and catalog.has_track(13) and catalog.has_track(14) and not catalog.has_track(15), "the eleven-module application bank covers stock contexts through Snow but no scenario Custom music"); assert_equal([catalog.track(1).get("context"), catalog.title(1), catalog.title(12), catalog.title(13), catalog.title(14)], ["Outdoor", "After the Rain", "After the Rain", "After the Rain", "After the Rain"], "Outdoor and its Desert, Swamp, and Snow contexts resolve the same tracker title"); var stream := catalog.stream(1); assert_true(stream is AudioStreamOggVorbis and (stream as AudioStreamOggVorbis).loop and catalog.stream(12) == stream and catalog.last_error.is_empty(), "the integrity-checked Outdoor module loads once as a looping portable stream shared by its terrain contexts"); var view := GameView.new(1, true, null, "map.fixture", Vector2i.ZERO, 1, 8, 0, MapView.new("map.fixture", "Fixture", &"land", 1, 1, Vector2i.ZERO, [], false, [], {}, Vector2i.ZERO, 0)); view.party_summary = PartySummaryView.new(); view.party_setup_available = true; view.character_draft = CharacterView.new(CharacterState.new("draft", "Draft", 10, 10)); assert_equal(ClassicMusicContext.playlist_for(&"setup", view), 0, "scenario selection, party assembly, and character creation stay silent before Begin Adventure"); view.party_setup_available = false; view.character_draft = null; assert_equal(ClassicMusicContext.playlist_for(&"exploration", view), 1, "ordinary land selects Outdoor only after Begin Adventure"); view.map_view.landlook = 3; assert_equal(ClassicMusicContext.playlist_for(&"exploration", view), 4, "cave landlook selects Cave"); view.map_view.landlook = 5; assert_equal(ClassicMusicContext.playlist_for(&"exploration", view), 12, "desert landlook selects Desert"); view.map_view.landlook = 6; assert_equal(ClassicMusicContext.playlist_for(&"exploration", view), 15, "custom landlook 6 selects Custom 1"); view.map_view.landlook = 7; assert_equal(ClassicMusicContext.playlist_for(&"exploration", view), 16, "custom landlook 7 selects Custom 2"); view.map_view.landlook = 8; assert_equal(ClassicMusicContext.playlist_for(&"exploration", view), 17, "custom landlook 8 selects Custom 3"); view.map_view.landlook = 9; assert_equal(ClassicMusicContext.playlist_for(&"exploration", view), 13, "swamp landlook selects Swamp"); view.map_view.landlook = 10; assert_equal(ClassicMusicContext.playlist_for(&"exploration", view), 14, "snow landlook selects Snow"); view.map_view.level_type = &"dungeon"; assert_equal(ClassicMusicContext.playlist_for(&"exploration", view), 2, "dungeon topology selects Dungeon"); view.map_view.level_type = &"land"; view.party_summary.camping = true; assert_equal(ClassicMusicContext.playlist_for(&"exploration", view), 9, "Camp overrides terrain"); view.party_summary.camping = false; assert_equal(ClassicMusicContext.playlist_for(&"inventory", view), 6, "Inventory selects Items"); view.map_view.landlook = 1; view.pending_interaction = InteractionRequest.new("treasure", InteractionRequest.TREASURE_DISTRIBUTION, InteractionRequest.Body.new()); assert_equal(ClassicMusicContext.playlist_for(&"exploration", view), 7, "Treasure interaction overrides terrain"); view.pending_interaction = null; assert_equal(ClassicMusicContext.playlist_for(&"exploration", view), 1, "closing Treasure restores the settled outdoor context"); view.pending_interaction = InteractionRequest.new("shop", InteractionRequest.SHOP, InteractionRequest.Body.new()); assert_equal(ClassicMusicContext.playlist_for(&"exploration", view), 8, "Shop interaction overrides terrain"); view.pending_interaction = InteractionRequest.new("temple", InteractionRequest.TEMPLE, InteractionRequest.Body.new()); assert_equal(ClassicMusicContext.playlist_for(&"exploration", view), 10, "Temple interaction overrides terrain"); view.pending_interaction = InteractionRequest.new("battle", InteractionRequest.COMBAT, InteractionRequest.Body.new()); assert_equal(ClassicMusicContext.playlist_for(&"exploration", view), 11, "Combat interaction overrides terrain"); var presenter := ClassicAudioPresenter.new(); (Engine.get_main_loop() as SceneTree).root.add_child(presenter); presenter.call("_ready"); presenter.set_master_volume(0.5); presenter.set_sound_volume(0.4); presenter.set_music_volume(0.8); var sound_channel := presenter.find_child("ClassicSoundChannel1", false, false) as AudioStreamPlayer; var music_channel := presenter.find_child("ClassicMusicChannel", false, false) as AudioStreamPlayer; assert_true(sound_channel != null and music_channel != null and is_equal_approx(db_to_linear(sound_channel.volume_db), 0.2) and is_equal_approx(db_to_linear(music_channel.volume_db), 0.4), "effects and music own separately composed channels"); settings = PresentationSettings.new(); settings.set_music_mode(1, PresentationSettings.MUSIC_OFF); presenter.present_music_context(1, settings, null, catalog); assert_equal(presenter.current_music_playlist_id, 0, "Off does not start a context title"); settings.set_music_mode(1, PresentationSettings.MUSIC_CONTINUE); presenter.present_music_context(1, settings, null, catalog); assert_equal(presenter.current_music_playlist_id, 0, "Continue does not start a title when none is playing"); settings.set_music_mode(1, PresentationSettings.MUSIC_PLAY); presenter.present_music_context(1, settings, null, catalog); assert_equal([presenter.current_music_playlist_id, presenter.current_music_title], [1, "After the Rain"], "Play starts the context title"); presenter.present_music_context(7, settings, null, catalog); var treasure_stream := music_channel.stream; presenter.present_music_context(1, settings, null, catalog); assert_true(presenter.current_music_playlist_id == 1 and music_channel.stream == catalog.stream(1) and music_channel.stream != treasure_stream, "leaving Treasure replaces its exact stream with Outdoor rather than retaining the departed context"); presenter.present_music_context(7, settings, null, catalog); var music_package := PackageRepository.new().load_package("res://tests/fixtures/packages/realmz2-synthetic-fixture.realmz2"); var scenario_media := ClassicMediaCatalog.new(music_package.media, ApplicationMediaCatalog.new()); presenter.present_music_context(15, settings, scenario_media, catalog); assert_true(music_package.is_ok() and [presenter.current_music_playlist_id, presenter.current_music_title] == [15, "Fixture Custom 1"] and music_channel.stream is AudioStreamWAV, "Custom 1 resolves only the package asset carrying its independent authored music slot"); presenter.present_music_context(7, settings, null, catalog); presenter.present_music_context(15, settings, null, catalog); assert_equal(presenter.current_music_playlist_id, 0, "leaving Treasure for an unavailable custom context stops the departed stream instead of leaking it into exploration"); settings.set_music_mode(12, PresentationSettings.MUSIC_PLAY); presenter.present_music_context(12, settings, null, catalog); assert_equal([presenter.current_music_playlist_id, presenter.current_music_title], [12, "After the Rain"], "Desert retains its distinct preference context while reusing Outdoor music"); settings.set_music_mode(2, PresentationSettings.MUSIC_CONTINUE); presenter.present_music_context(2, settings, null, catalog); assert_equal([presenter.current_music_playlist_id, presenter.current_music_title], [12, "After the Rain"], "Continue retains the current title across contexts"); settings.set_music_mode(2, PresentationSettings.MUSIC_OFF); presenter.present_music_context(2, settings, null, catalog); assert_equal(presenter.current_music_playlist_id, 0, "Off stops the prior context title on entry"); presenter.free(); var dialog := MusicPlaylistDialog.new(); (Engine.get_main_loop() as SceneTree).root.add_child(dialog); dialog.call("_ready"); settings = PresentationSettings.new(); dialog.open(settings, 1, "After the Rain", true); assert_true(dialog.visible and dialog.find_child("MusicDone", true, false) != null and dialog.find_children("Playlist??", "HBoxContainer", true, false).size() == 20, "the locked window exposes all twenty slots and a contiguous Done action"); assert_true((dialog.find_child("Playlist18Play", true, false) as Button).disabled and (dialog.find_child("Playlist20Off", true, false) as Button).disabled, "unused slots remain visible and reserved"); (dialog.find_child("Playlist11Continue", true, false) as Button).pressed.emit(); assert_equal(settings.music_mode(11), PresentationSettings.MUSIC_CONTINUE, "playlist controls update the selected context mode"); dialog.set_anchors_and_offsets_preset(Control.PRESET_TOP_LEFT); dialog.size = Vector2(1280, 720); dialog.call("_apply_layout"); var panel := dialog.find_child("MusicPlaylistWindow", true, false) as PanelContainer; assert_true(panel.custom_minimum_size.x <= 1232.0 and panel.custom_minimum_size.y <= 680.0, "the playlist modal is bounded at 1280x720"); dialog.size = Vector2(800, 600); dialog.call("_apply_layout"); assert_true(panel.custom_minimum_size.x <= 752.0 and panel.custom_minimum_size.y <= 560.0, "the playlist modal is bounded at 800x600"); (dialog.find_child("MusicDone", true, false) as Button).pressed.emit(); assert_false(dialog.visible, "Done returns without requiring Escape"); dialog.free()
