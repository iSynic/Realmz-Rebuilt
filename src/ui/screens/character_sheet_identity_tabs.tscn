theme_override_colors/font_color = Color(0.604, 0.627, 0.659, 1)
text = "Portrait and tactical icon change independently"
[node name="AppearanceRegions" type="BoxContainer" parent="AppearanceTab"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14

