{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "realmz-remake-source-intelligence-v1",
  "title": "Realmz Remake source intelligence",
  "type": "object",
  "required": ["schema_version", "repository", "scope", "exclusions", "files", "entities", "relations", "flows", "diagnostics"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "generator_version": {"type": "string"},
    "repository": {
      "type": "object",
      "required": ["name", "commit", "working_tree_dirty", "generated_at"],
      "properties": {
        "name": {"type": "string"},
        "commit": {"type": "string"},
        "working_tree_dirty": {"type": "boolean"},
        "generated_at": {"type": "string"}
      },
      "additionalProperties": true
    },
    "scope": {"type": "array", "items": {"type": "string"}},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "flows": {"type": "array", "items": {"$ref": "#/$defs/flow"}},
    "diagnostics": {"type": "array", "items": {"type": "object"}},
    "search_documents": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": ["path", "start_line", "end_line", "file_sha256", "commit"],
      "properties": {
        "path": {"type": "string"},
        "symbol": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1},
        "start_column": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "end_column": {"type": "integer", "minimum": 1},
        "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "commit": {"type": "string"},
        "text": {"type": "string"}
      },
      "additionalProperties": true
    },
    "file": {
      "type": "object",
      "required": ["id", "path", "sha256", "line_count", "content"],
      "properties": {
        "id": {"type": "string"},
        "path": {"type": "string"},
        "sha256": {"type": "string"},
        "line_count": {"type": "integer"},
        "content": {"type": "string"},
        "module_id": {"type": ["string", "null"]},
        "dox_scope_id": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "entity": {
      "type": "object",
      "required": ["id", "kind", "name", "evidence"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string"},
        "name": {"type": "string"},
        "path": {"type": ["string", "null"]},
        "summary": {"type": "string"},
        "module_id": {"type": ["string", "null"]},
        "dox_scope_id": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/span"}}
      },
      "additionalProperties": true
    },
    "relation": {
      "type": "object",
      "required": ["id", "from", "to", "type", "status", "evidence"],
      "properties": {
        "id": {"type": "string"},
        "from": {"type": "string"},
        "to": {"type": ["string", "null"]},
        "type": {"type": "string"},
        "status": {"enum": ["resolved", "unknown", "external"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/span"}},
        "resolver": {"type": "string"},
        "unresolved_text": {"type": "string"}
      },
      "additionalProperties": true
    },
    "flow": {
      "type": "object",
      "required": ["id", "label", "primary", "trigger", "steps", "outcome"],
      "properties": {
        "id": {"type": "string"},
        "label": {"type": "string"},
        "primary": {"type": "boolean"},
        "trigger": {"type": "object"},
        "steps": {"type": "array", "items": {"type": "object"}},
        "outcome": {"type": "string"},
        "tests": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
