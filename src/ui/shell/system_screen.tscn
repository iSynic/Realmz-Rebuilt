[gd_scene load_steps=5 format=3]

[ext_resource type="PackedScene" path="res://src/ui/shared/screen_frame.tscn" id="1_base"]
[ext_resource type="Script" path="res://src/ui/shell/system_screen.gd" id="2_screen"]
[ext_resource type="PackedScene" path="res://src/ui/shell/system_workspace.tscn" id="3_workspace"]

[ext_resource type="Theme" path="res://src/ui/shared/style/menu_controls_theme.tres" id="4_theme"]

[node name="SystemScreen" instance=ExtResource("1_base")]
theme = ExtResource("4_theme")
theme_type_variation = &"SettingsSurface"
route_id = &"system"
title = "Settings"
description = ""
script = ExtResource("2_screen")

[node name="SystemWorkspace" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody" instance=ExtResource("3_workspace")]
layout_mode = 2

[node name="SystemAlternateContent" type="VBoxContainer" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody"]
visible = false
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="ScreenDescription" parent="WorkspaceColumn/WorkspaceHeader" index="1"]
visible = false

[node name="ScreenBodyScroll" parent="WorkspaceColumn/BodyClip" index="0"]
vertical_scroll_mode = 0

[node name="ScreenTitle" parent="WorkspaceColumn/WorkspaceHeader" index="0"]
theme_override_font_sizes/font_size = 44

[node name="RouteBackAction" parent="WorkspaceColumn/WorkspaceHeader" index="2"]
theme_override_font_sizes/font_size = 24

[node name="HeaderRule" parent="WorkspaceColumn" index="1"]
visible = false
