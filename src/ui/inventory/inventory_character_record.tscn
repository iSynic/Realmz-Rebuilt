[gd_scene format=3]

[node name="InventoryCharacterRecord" type="VBoxContainer"]
theme_override_constants/separation = 3

[node name="InventoryCharacterIdentity" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Portrait" type="TextureRect" parent="InventoryCharacterIdentity"]
custom_minimum_size = Vector2(44, 44)
layout_mode = 2
texture_filter = 1
expand_mode = 1
stretch_mode = 5

[node name="IdentityText" type="VBoxContainer" parent="InventoryCharacterIdentity"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 1

[node name="Name" type="Label" parent="InventoryCharacterIdentity/IdentityText"]
layout_mode = 2
theme_override_colors/font_color = Color(0.835294, 0.705882, 0.364706, 1)
theme_override_font_sizes/font_size = 20
text = "Character"
text_overrun_behavior = 3

[node name="Role" type="Label" parent="InventoryCharacterIdentity/IdentityText"]
layout_mode = 2
theme_override_colors/font_color = Color(0.878431, 0.886275, 0.898039, 1)
theme_override_font_sizes/font_size = 13
text = "Race / Caste • Level 1"
text_overrun_behavior = 3

[node name="Progression" type="Label" parent="InventoryCharacterIdentity/IdentityText"]
layout_mode = 2
theme_override_colors/font_color = Color(0.603922, 0.627451, 0.658824, 1)
theme_override_font_sizes/font_size = 12
text = "Victory 0 • Load 0/0"
text_overrun_behavior = 3

[node name="InventoryCharacterFacts" type="GridContainer" parent="."]
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 2
columns = 3

[node name="Health" type="PanelContainer" parent="InventoryCharacterFacts"]
custom_minimum_size = Vector2(125, 25)
layout_mode = 2
theme_type_variation = &"ClassicInventoryFactCell"
[node name="Value" type="Label" parent="InventoryCharacterFacts/Health"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "HP 10/10"

[node name="SpellPoints" type="PanelContainer" parent="InventoryCharacterFacts"]
custom_minimum_size = Vector2(125, 25)
layout_mode = 2
theme_type_variation = &"ClassicInventoryFactCell"
