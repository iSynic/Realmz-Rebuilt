[node name="CombatTextBackgroundValue" type="Label" parent="Columns/ControlsColumn/CombatTextBackgroundGroup/CombatTextBackgroundRow"]
layout_mode = 2
size_flags_horizontal = 3
horizontal_alignment = 2
text = "50%"

[node name="CombatTextBackgroundSlider" type="HSlider" parent="Columns/ControlsColumn/CombatTextBackgroundGroup"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
size_flags_horizontal = 3
focus_neighbor_top = NodePath("../../CombatTextSpeedGroup/CombatTextSpeedSlider")
focus_neighbor_bottom = NodePath("../../CombatTextMotionRow/CombatTextMotion")
