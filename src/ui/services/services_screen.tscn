[gd_scene load_steps=4 format=3]
[ext_resource type="PackedScene" path="res://src/ui/shared/screen_frame.tscn" id="1_base"]
[ext_resource type="Script" path="res://src/ui/services/services_screen.gd" id="2_screen"]
[ext_resource type="PackedScene" path="res://src/ui/services/services_workspace.tscn" id="3_workspace"]
[node name="ServicesScreen" instance=ExtResource("1_base")]
route_id = &"services"
script = ExtResource("2_screen")

[node name="ScreenTitle" parent="WorkspaceColumn/WorkspaceHeader" index="0"]
text = "Party Wealth"

[node name="ScreenDescription" parent="WorkspaceColumn/WorkspaceHeader" index="1"]
text = "Pool, share, and exchange carried wealth."

[node name="RouteBackAction" parent="WorkspaceColumn/WorkspaceHeader" index="2"]
visible = false

[node name="ServicesWorkspace" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll/ScreenBody" instance=ExtResource("3_workspace")]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
