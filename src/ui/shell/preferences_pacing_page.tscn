[gd_scene load_steps=1 format=3]



[node name="Pacing" type="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
[node name="PacingSettingsScroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0
[node name="PacingSettingsPanel" type="PanelContainer" parent="PacingSettingsScroll"]
layout_mode = 2
size_flags_horizontal = 3
[node name="Content" type="VBoxContainer" parent="PacingSettingsScroll/PacingSettingsPanel"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10
[node name="CombatSpeedRow" type="BoxContainer" parent="PacingSettingsScroll/PacingSettingsPanel/Content" groups=["system_setting_rows"]]
layout_mode = 2
[node name="CombatPlaybackSpeedCaption" type="Label" parent="PacingSettingsScroll/PacingSettingsPanel/Content/CombatSpeedRow"]
custom_minimum_size = Vector2(230, 0)
layout_mode = 2
text = "Combat & animation speed"
[node name="CombatPlaybackSpeedSlider" type="HSlider" parent="PacingSettingsScroll/PacingSettingsPanel/Content/CombatSpeedRow"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 25.0
max_value = 200.0
step = 25.0
tick_count = 8
ticks_on_borders = true
[node name="CombatExplanation" type="Label" parent="PacingSettingsScroll/PacingSettingsPanel/Content"]
layout_mode = 2
text = "100% is the designed combat pace. Scrolling text has its own speed below."
autowrap_mode = 2
[node name="CombatTextSpeedRow" type="BoxContainer" parent="PacingSettingsScroll/PacingSettingsPanel/Content" groups=["system_setting_rows"]]
layout_mode = 2
