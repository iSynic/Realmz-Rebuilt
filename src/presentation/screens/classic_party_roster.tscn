text = "Party"

[node name="PartyScroll" type="ScrollContainer" parent="RosterColumn"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
vertical_scroll_mode = 1
follow_focus = true

[node name="PartyList" type="VBoxContainer" parent="RosterColumn/PartyScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 3

[node name="SpellbookFooter" type="VBoxContainer" parent="RosterColumn"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 3
