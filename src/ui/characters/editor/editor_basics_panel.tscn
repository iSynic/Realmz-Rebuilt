theme_type_variation = &"MenuHeading"
theme_override_font_sizes/font_size = 18
text = "Stamina, spell points and armor"

[node name="Spacer" type="Control" parent="Content/VitalsHeader"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Caption" type="Label" parent="Content/VitalsHeader"]
layout_mode = 2
