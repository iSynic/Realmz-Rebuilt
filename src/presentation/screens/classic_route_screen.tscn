[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/presentation/screens/classic_route_screen.gd" id="1_route"]

[node name="ClassicRouteScreen" type="PanelContainer"]
script = ExtResource("1_route")

[node name="WorkspaceColumn" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="WorkspaceHeader" type="BoxContainer" parent="WorkspaceColumn"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="ScreenTitle" type="Label" parent="WorkspaceColumn/WorkspaceHeader"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ClassicHeading"
text = "Realmz"

[node name="ScreenDescription" type="Label" parent="WorkspaceColumn/WorkspaceHeader"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.49, 0.83, 0.9, 1)
text = "Workspace"
vertical_alignment = 1
autowrap_mode = 2

[node name="RouteBackAction" type="Button" parent="WorkspaceColumn/WorkspaceHeader"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(82, 34)
tooltip_text = "Return to the previous screen."
text = "Back"

[node name="HeaderRule" type="HSeparator" parent="WorkspaceColumn"]
layout_mode = 2

[node name="BodyClip" type="Control" parent="WorkspaceColumn"]
layout_mode = 2
size_flags_vertical = 3
clip_contents = true

[node name="ScreenBodyScroll" type="ScrollContainer" parent="WorkspaceColumn/BodyClip"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
horizontal_scroll_mode = 0
vertical_scroll_mode = 1
follow_focus = true
mouse_filter = 1

[node name="ScreenBody" type="VBoxContainer" parent="WorkspaceColumn/BodyClip/ScreenBodyScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 7
